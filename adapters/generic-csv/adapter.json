{
  "id": "generic-csv",
  "version": "1.0.0",
  "display_name": "Generic (auto-detect)",
  "description": "Fallback adapter that auto-detects delimiter, encoding, header row, columns, date format and number format using the built-in English/Spanish alias table. Works with most bank CSV and XLSX exports.",
  "supported_formats": ["csv", "xlsx"],
  "locales": ["en", "es"],
  "expected_headers": [],
  "header_aliases": {},
  "rows_to_skip": 0,
  "footer_patterns": [],
  "date_formats": [],
  "decimal_separator": null,
  "thousands_separator": null,
  "transaction_order": "auto",
  "currency": null,
  "amount_mode": "auto",
  "date_column": null,
  "debit_column": null,
  "credit_column": null,
  "signed_amount_column": null,
  "balance_column": null,
  "reference_column": null,
  "description_column": null,
  "currency_column": null,
  "account_column": null,
  "account_masking_rules": { "min_digits": 6, "keep_last": 4 },
  "detection_priority": 10
}
